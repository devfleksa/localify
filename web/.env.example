# Easiest: run `npm run setup` (asks for each key, tests it, writes .env.local).
# Or copy this file to .env.local and fill it in; `npm run setup -- --check` tests the keys.

# Manus: plans what to change per market. https://manus.im → Settings → API
# A plan costs a few Manus credits per post.
MANUS_API_KEY=

# fal: scans posts (vision model) and edits the images. https://fal.ai/dashboard/keys
# Scan ~$0.002 per post, edit $0.15 per image.
FAL_KEY=

# Apify: imports the Instagram posts. https://console.apify.com/account/integrations
# ~$0.001 per post read (Reels are read too, then skipped).
# Without it the app only uses posts already saved in data/uploads/library/<handle>/.
APIFY_TOKEN=

# Optional. Unset = no login (local use). Set it when others can reach the app, so they can't spend your credits.
# ACCESS_CODE=

# Optional. PLAN_CACHE=prefer reuses a saved Manus plan for a post instead of asking Manus again (faster, free).
# PLAN_CACHE=prefer
